{
  "name": "@omnipad/vanilla",
  "version": "0.7.3",
  "description": "Vanilla JS adapter and component library for OmniPad. Build highly customizable virtual gamepads for web-based games with ease.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.mjs",
      "require": "./dist/utils.js"
    },
    "./const": {
      "types": "./dist/const.d.ts",
      "import": "./dist/const.mjs",
      "require": "./dist/const.js"
    },
    "./guest": {
      "types": "./dist/guest.d.ts",
      "import": "./dist/guest.mjs",
      "require": "./dist/guest.js"
    },
    "./style.css": "./dist/index.css"
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/index.d.ts"
      ],
      "utils": [
        "./dist/utils.d.ts"
      ],
      "const": [
        "./dist/const.d.ts"
      ],
      "guest": [
        "./dist/guest.d.ts"
      ]
    }
  },
  "dependencies": {
    "@omnipad/core": "workspace:*",
    "@omnipad/web": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^27.4.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.28.2",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omnipad-js/omnipad.git"
  }
}
